            const angleStep = (2 * Math.PI) / 6;

            for (let i = 0; i < 6; i++) {
                ctx.beginPath();
                ctx.fillStyle = colors[i];
                ctx.moveTo(128, 128);
                ctx.arc(128, 128, 128, i * angleStep, (i + 1) * angleStep);
                ctx.fill();

                ctx.save();
                ctx.translate(128, 128);
                ctx.rotate(i * angleStep + angleStep / 2);
                ctx.textAlign = "right";
                ctx.fillStyle = "#FFF";
                ctx.font = "bold 12px sans-serif";
                ctx.fillText(wheelTopics[i].name, 110, 4);
                ctx.restore();
